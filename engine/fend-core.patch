+	fn approximate_pow<I: Interrupt>(self, rhs: Self, int: &I) -> FResult<Exact<Self>> {
+		if self.num == 0.into() {
+			return Ok(Exact::new(0.into(), true));
+		}
+		let base = self.clone().into_f64(int)?;
+		let exponent = rhs.into_f64(int)?;
+		let value = if base.is_finite() && base > 0.0 {
+			base.powf(exponent)
+		} else {
+			// Taking the log first also supports bases larger than f64::MAX.
+			2.0_f64.powf(self.log2(int)?.into_f64(int)? * exponent)
+		};
+		if !value.is_finite() || value == 0.0 {
+			return Err(FendError::ApproximationOutOfRange);
+		}
+		// Preserve the finite float's complete exponent range. The existing
+		// from_f64 helper scales by u64::MAX and clips large or tiny results.
