+use fend_core::{Context, evaluate};
+
+fn near(input: &str, expected: f64) {
+	let output = evaluate(input, &mut Context::new()).unwrap();
+	let output = output.get_main_result();
+	let value: f64 = output
+		.strip_prefix("approx. ")
+		.unwrap_or(output)
+		.parse()
+		.unwrap();
+	assert!(
+		(value - expected).abs() <= expected.abs().max(1e-100) * 1e-9,
+		"{input}: {output}"
+	);
+}
+
+#[test]
+fn integer_log_bases() {
+	for (input, expected) in [
+		("log7(8)", 1.0686215613240664),
+		("log7(8+2)", 1.1832946624549384),
+		("log3(27)", 3.0),
+		("log0007(8)", 1.0686215613240664),
+		("LOG7(8)", 1.0686215613240664),
+		("log1000000000000000000000000000000(100)", 1.0 / 15.0),
+		("log7(log3(27)+5)", 1.0686215613240664),
+	] {
+		near(input, expected);
+	}
+	assert_eq!(
+		evaluate("log7 1", &mut Context::new())
+			.unwrap()
+			.get_main_result(),
+		"approx. 0"
+	);
+}
+
+#[test]
+fn log_names_preserve_scoping_and_builtin_ln() {
+	for (input, expected) in [
+		("log7 = x:x+1; log7(8)", 9.0),
+		("(log7:log7(8))(x:x+2)", 10.0),
+		("log7=4; log7 * 2", 8.0),
+		("log0=x:x+1; log0(8)", 9.0),
+		("ln=x:0; log7(8)", 1.0686215613240664),
+		("f=x:log7(x+1); f(7)", 1.0686215613240664),
+	] {
+		near(input, expected);
+	}
+	let mut context = Context::new();
+	evaluate("g = log7", &mut context).unwrap();
+	let mut saved = vec![];
+	context.serialize_variables(&mut saved).unwrap();
+	let mut restored = Context::new();
+	restored
+		.deserialize_variables(&mut saved.as_slice())
+		.unwrap();
+	assert_eq!(
+		evaluate("g(8)", &mut restored).unwrap().get_main_result(),
+		"approx. 1.0686215613"
+	);
+}
+
+#[test]
+fn invalid_log_bases_and_strings() {
+	for input in ["log0(5)", "log1(5)", "log000(5)", "log001(5)"] {
+		assert_eq!(
+			evaluate(input, &mut Context::new()).unwrap_err(),
+			"base must be at least 2"
+		);
+	}
+	for input in ["log7(0)", "log7(1m)", "log7x(8)"] {
+		assert!(evaluate(input, &mut Context::new()).is_err());
+	}
+	assert_eq!(
+		evaluate("\"log7(8)\"", &mut Context::new())
+			.unwrap()
+			.get_main_result(),
+		"log7(8)"
+	);
+}
+
+#[test]
+fn logarithms_can_be_used_as_exponents() {
+	for (input, expected) in [
+		("10^(log(5))", 5.0),
+		("2^(log2(5))", 5.0),
+		("7^(log7(8))", 8.0),
+		("exp(ln(5))", 5.0),
+		("10^(-log(5))", 0.2),
+		("x=log(5); 10^x", 5.0),
+		("f=x:10^(log(x)); f(5)", 5.0),
+		("10^(100+2^-80) to 4 sf", 1e100),
+		("10^(-100-2^-80) to 4 sf", 1e-100),
+	] {
+		near(input, expected);
+	}
+}
+
+#[test]
+fn exact_arithmetic_and_error_paths_are_preserved() {
+	assert_eq!(
+		evaluate("4^(10001/2) == 2^10001", &mut Context::new())
+			.unwrap()
+			.get_main_result(),
+		"true"
+	);
+	for (input, expected) in [
+		("16^(1/4)", "2"),
+		("2^100 to exact", "1267650600228229401496703205376"),
+		("(1/3)^3 to exact", "1/27"),
+	] {
+		assert_eq!(
+			evaluate(input, &mut Context::new())
+				.unwrap()
+				.get_main_result(),
+			expected
+		);
+	}
+	for input in ["0^0", "1/0", "10^(2^65)"] {
+		assert!(evaluate(input, &mut Context::new()).is_err());
+	}
+	assert_eq!(
+		evaluate("10^(1000+2^-80)", &mut Context::new()).unwrap_err(),
+		"result is outside the supported approximation range"
+	);
+}
